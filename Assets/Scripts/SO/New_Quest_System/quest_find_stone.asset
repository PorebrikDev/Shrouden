  quest_name: "\u041D\u0430\u0439\u0442\u0438 \u043A\u0430\u043C\u0435\u043D\u044C"
  quest_description:
  - "\u0421\u0442\u0430\u0440\u0438\u043A \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
    \u043D\u0430\u0439\u0442\u0438 \u0435\u0433\u043E \u043A\u0430\u043C\u0435\u043D\u044C.
    \u0412\u0440\u044F\u0434-\u043B\u0438 \u0432\u043E\u0440\u043E\u043D\u044B \u0443\u043D\u0435\u0441\u043B\u0438
    \u0435\u0433\u043E \u0434\u0430\u043B\u0435\u043A\u043E."
  - "\u042F \u043D\u0430\u0448\u0435\u043B \u043A\u0430\u043C\u0435\u043D\u044C \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0438\u0437\u043B\u0443\u0447\u0430\u0435\u0442 \u0441\u0432\u0435\u0442."
  quest_completed_description: "\u042F \u043E\u0442\u0434\u0430\u043B \u043A\u0430\u043C\u0435\u043D\u044C
    \u0441\u0442\u0430\u0440\u0438\u043A\u0443, \u0432\u0437\u0430\u043C\u0435\u043D,
    \u043E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C
    \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0435
    \u0432 \u0441\u0432\u043E\u0435\u043C \u0441\u0443\u043D\u0434\u0443\u043A\u0435."
